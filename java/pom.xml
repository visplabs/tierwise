<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.visplabs</groupId>
  <artifactId>tierwise-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Tierwise</name>
  <description>Tierwise parent POM: the Java reference toolchain, runtimes and control plane for tiered feature and entitlement configuration.</description>
  <!--
    The project's home is github.com/visplabs/tierwise (ADR 0028). If it moves, change url, issueManagement
    and the three scm URLs together; docs/release-process.md step 1 explains the checks.
  -->
  <url>https://github.com/visplabs/tierwise</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>djkeshawa</id>
      <name>djkeshawa</name>
      <url>https://github.com/djkeshawa</url>
      <roles>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>
  <scm>
    <!-- The attributes keep the module POMs from appending their artifactId to these URLs. -->
    <url child.scm.url.inherit.append.path="false">https://github.com/visplabs/tierwise</url>
    <connection child.scm.connection.inherit.append.path="false">scm:git:https://github.com/visplabs/tierwise.git</connection>
    <developerConnection child.scm.developerConnection.inherit.append.path="false">scm:git:ssh://git@github.com/visplabs/tierwise.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/visplabs/tierwise/issues</url>
  </issueManagement>
  <modules>
    <module>tierwise-core</module>
    <module>tierwise-cli</module>
    <module>tierwise-spring-boot-starter</module>
    <module>tierwise-spring-boot-starter-s3</module>
    <module>tierwise-server</module>
    <module>tierwise-server-s3</module>
    <module>tierwise-openfeature</module>
    <!-- Test-only: the end-to-end test. It publishes nothing (maven.deploy.skip). -->
    <module>tierwise-e2e</module>
  </modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Modules override this. The release flag checks the API of the target version (ADR 0012). -->
    <maven.compiler.release>17</maven.compiler.release>
    <tierwise.supported.spec.versions>none</tierwise.supported.spec.versions>
    <tierwise.supported.bundle.format.versions>none</tierwise.supported.bundle.format.versions>

    <!--
      Build output directory of every module. Parallel worktrees override it, for example with
      -Dtierwise.buildDir=/tmp/work/target when only one module is built (the value is shared by
      every module of a reactor build).
    -->
    <tierwise.buildDir>${project.basedir}/target</tierwise.buildDir>
    <!-- Tests tagged "conformance" (the spec suite) are excluded unless the conformance profile is active.
         A module with tests passes this property to surefire's excludedGroups. -->
    <tierwise.excludedGroups>conformance</tierwise.excludedGroups>

    <!--
      Switches of the release profile. A module that must not be published (the end-to-end test module and
      any module that holds only tests) sets maven.deploy.skip to true in its own properties, as tierwise-e2e
      does; the release profile then builds no sources or Javadoc JAR for it, and leaves it out of the Central
      bundle. scripts/check-foundation.py checks that every module outside its list of published modules sets it.
    -->
    <maven.deploy.skip>false</maven.deploy.skip>
    <!--
      Signing is off unless the release workflow turns it on with -Dtierwise.gpg.skip=false (a PGP key was
      imported) and -Dtierwise.sigstore.skip=false (the job has an OIDC token). A local build and the dry
      run therefore never sign anything and need no secrets.
    -->
    <tierwise.gpg.skip>true</tierwise.gpg.skip>
    <tierwise.sigstore.skip>true</tierwise.sigstore.skip>

    <!-- Library versions approved in ADR 0012. -->
    <version.snakeyaml-engine>3.2</version.snakeyaml-engine>
    <version.jackson>2.22.4</version.jackson>
    <version.junit>6.1.3</version.junit>
    <version.jqwik>1.10.1</version.jqwik>
    <version.picocli>4.7.7</version.picocli>

    <!-- Plugin versions approved in ADR 0012. Dependabot proposes updates. -->
    <version.clean>3.5.0</version.clean>
    <version.resources>3.5.0</version.resources>
    <version.compiler>3.16.0</version.compiler>
    <version.surefire>3.6.0</version.surefire>
    <version.jar>3.5.1</version.jar>
    <version.install>3.2.0</version.install>
    <version.deploy>3.2.0</version.deploy>
    <version.site>3.22.0</version.site>
    <version.enforcer>3.6.3</version.enforcer>
    <version.shade>3.6.2</version.shade>
    <!-- Release tooling (ADR 0022). These plugins run only in the release profile. -->
    <version.source>3.4.0</version.source>
    <version.javadoc>3.12.0</version.javadoc>
    <version.gpg>3.2.8</version.gpg>
    <version.sigstore>2.3.0</version.sigstore>
    <version.central-publishing>0.11.0</version.central-publishing>
    <!-- Runtime integration dependencies (ADR 0020). Spring and AWS BOMs are imported by the modules that use them. -->
    <version.spring-boot>4.1.1</version.spring-boot>
    <version.awssdk>2.55.11</version.awssdk>
    <version.openfeature>1.23.0</version.openfeature>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${version.snakeyaml-engine}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${version.jackson}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${version.jqwik}</version>
      </dependency>
      <dependency>
        <groupId>dev.openfeature</groupId>
        <artifactId>sdk</artifactId>
        <version>${version.openfeature}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${version.picocli}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <directory>${tierwise.buildDir}</directory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${version.clean}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${version.resources}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.compiler}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.surefire}</version>
          <!--
            Surefire rejects excludedGroups in a module without JUnit 5 on its classpath, so a module
            with tests adds <excludedGroups>${tierwise.excludedGroups}</excludedGroups> itself.
          -->
          <configuration>
            <systemPropertyVariables>
              <tierwise.spec.dir>${project.basedir}/../../spec</tierwise.spec.dir>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${version.jar}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${version.install}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${version.deploy}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${version.site}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${version.enforcer}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${version.shade}</version>
        </plugin>
        <plugin>
          <!-- Sources JAR, required by Maven Central. Bound by the release profile (ADR 0022). -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${version.source}</version>
        </plugin>
        <plugin>
          <!-- Javadoc JAR, required by Maven Central. Bound by the release profile (ADR 0022). -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${version.javadoc}</version>
        </plugin>
        <plugin>
          <!-- PGP signatures, required by Maven Central. Skipped unless a key is provided (ADR 0022). -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${version.gpg}</version>
        </plugin>
        <plugin>
          <!-- Sigstore bundles (keyless; the workflow's OIDC token is the identity). Skipped by default. -->
          <groupId>dev.sigstore</groupId>
          <artifactId>sigstore-maven-plugin</artifactId>
          <version>${version.sigstore}</version>
        </plugin>
        <plugin>
          <!-- Central Portal upload, in the release profile only, with autoPublish=false (ADR 0022). -->
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${version.central-publishing}</version>
        </plugin>
        <plugin>
          <!-- Repackages tierwise-server as an executable JAR (classifier exec). The Spring Boot BOM version. -->
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${version.spring-boot}</version>
        </plugin>
        <plugin>
          <!-- Native image build of the CLI, bound only by the native profile of tierwise-cli (ADR 0012). -->
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>1.1.14</version>
        </plugin>
        <plugin>
          <!-- CycloneDX SBOM per module, as JSON at target/bom.json (ADR 0012, requirements 1.2). -->
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
          <configuration>
            <outputFormat>json</outputFormat>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!-- The reactor builds on JDK 21; release 17 keeps core, CLI and OpenFeature on the Java 17 API. -->
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requirePluginVersions>
                  <banSnapshots>true</banSnapshots>
                </requirePluginVersions>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Release build (ADR 0022, docs/release-process.md). Adds what Maven Central requires on top of the normal
        build: a sources JAR and a Javadoc JAR for every module, a CycloneDX SBOM attached to every module,
        PGP signatures and Sigstore bundles for every attached file, and the Central Portal upload.

        Nothing here publishes by itself: the upload happens only in the deploy phase, and only with credentials
        for the server id "central" in settings.xml. The release workflow calls deploy only when its dry_run input
        is false. "verify -Prelease" builds and checks everything and uploads nothing.

        The build is reproducible: project.build.outputTimestamp fixes every timestamp, and
        scripts/reproducibility-check.sh compares two builds of the same sources.
      -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <configuration>
              <skipSource>${maven.deploy.skip}</skipSource>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <skip>${maven.deploy.skip}</skip>
              <release>${maven.compiler.release}</release>
              <quiet>true</quiet>
              <!-- Everything but "missing": a private serialized field without a comment is not an API gap. -->
              <doclint>all,-missing</doclint>
              <failOnWarnings>true</failOnWarnings>
              <failOnError>true</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!--
              One SBOM for every module, attached as <artifact>-<version>-cyclonedx.json. The id "sbom" is the id that
              tierwise-cli already uses, so the CLI keeps its own configuration (projectType application) and runs the
              goal once.
            -->
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!--
              Sigstore comes before GPG on purpose: both run in the verify phase in POM order, so the PGP plugin
              then also signs the .sigstore.json bundles, and Central gets a signature for every file.
            -->
            <groupId>dev.sigstore</groupId>
            <artifactId>sigstore-maven-plugin</artifactId>
            <configuration>
              <skip>${tierwise.sigstore.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <id>sigstore-sign</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <configuration>
              <skip>${tierwise.gpg.skip}</skip>
              <!-- The key is imported by the workflow; the passphrase comes from MAVEN_GPG_PASSPHRASE. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!--
              Replaces the deploy plugin for the reactor: collects every module into one bundle and uploads it to the
              Central Portal. autoPublish=false leaves the validated deployment waiting in the portal, so a person
              reviews it and presses Publish there (docs/release-process.md). The credentials are the server id
              "central" in settings.xml; the release workflow writes them from secrets.
            -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <skipPublishing>${maven.deploy.skip}</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Runs the spec conformance suite (tests tagged "conformance") with the other tests. -->
      <id>conformance</id>
      <properties>
        <tierwise.excludedGroups></tierwise.excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
